# ─── Database ─────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://username:password@your-neon-host.neon.tech/neondb?ssl=require

# ─── Neon Auth / JWT Secret ───────────────────────────────
NEON_AUTH_SECRET=your_neon_auth_secret_or_jwt_secret_here

# ─── Gemini AI ────────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here

# ─── Resend Transactional Email API ───────────────────────
RESEND_API_KEY=your_resend_api_key_here
SENDER_EMAIL=onboarding@resend.dev

# ─── Cloudflare Workers AI (image generation) ─────────────
CF_ACCOUNT_ID=your_cloudflare_account_id_here
CF_API_TOKEN=your_cloudflare_api_token_here

# ─── VAPID Push Notifications ─────────────────────────────
# Generate with: python generate_vapid.py
VAPID_PRIVATE_KEY=your_vapid_private_key_here
VAPID_PUBLIC_KEY=your_vapid_public_key_here
VAPID_EMAIL=mailto:your@email.com

# ─── App ──────────────────────────────────────────────────
FRONTEND_URL=http://localhost:5173
ENVIRONMENT=development
